job "{{ job_name }}" {
  datacenters = ["*"]
  type        = "service"
  node_pool   = "{{ node_pool }}"

  group "worker" {
    task "heartbeat" {
      driver = "exec"

      config {
        command = "/bin/sh"
        args    = ["-c", "n=0; while true; do n=$((n+1)); echo \"$n $(date +%s)\" > /local/heartbeat; sleep 5; done"]
      }

      resources {
        cpu    = 50
        memory = 32
      }
    }
  }
}
